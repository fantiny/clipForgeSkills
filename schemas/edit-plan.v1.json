{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClipForge EditPlan v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "content_id", "purpose", "brief", "canvas", "clips", "subtitles", "audio", "fact_ids", "style"],
  "properties": {
    "schema_version": {"const": 1},
    "content_id": {"type":"string", "pattern":"^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"},
    "master_id": {"type":"string", "maxLength":80},
    "variant_id": {"type":"string", "maxLength":80},
    "purpose": {"enum":["production","technical_test","internal_review"]},
    "brief": {"type":"object", "additionalProperties":false, "required":["scenario","sku","audience","channel","cta"], "properties": {
      "scenario":{"enum":["product","knowledge","experience","promotion","service","store"]},
      "sku":{"type":"string","minLength":1,"maxLength":100},
      "audience":{"type":"string","minLength":1,"maxLength":500},
      "channel":{"type":"string","minLength":1,"maxLength":100},
      "cta":{"type":["string","null"],"maxLength":500},
      "store_id":{"type":"string","maxLength":100}
    }},
    "canvas":{"type":"object","additionalProperties":false,"required":["width","height","fps"],"properties":{
      "width":{"type":"integer","minimum":128,"maximum":3840,"multipleOf":2},
      "height":{"type":"integer","minimum":128,"maximum":3840,"multipleOf":2},
      "fps":{"enum":[24,25,30,50,60]}
    }},
    "clips":{"type":"array","minItems":1,"maxItems":200,"items":{"type":"object","additionalProperties":false,"required":["asset_id","start","end","role","audio"],"properties":{
      "asset_id":{"type":"string","pattern":"^asset_[a-f0-9]{24}$"},
      "start":{"type":"number","minimum":0},"end":{"type":"number","exclusiveMinimum":0},
      "role":{"type":"string","minLength":1,"maxLength":100},"audio":{"enum":["keep","mute"]}
    }}},
    "subtitles":{"type":"array","maxItems":500,"items":{"type":"object","additionalProperties":false,"required":["start","end","text","fact_ids"],"properties":{
      "start":{"type":"number","minimum":0},"end":{"type":"number","exclusiveMinimum":0},
      "text":{"type":"string","minLength":1,"maxLength":200},
      "fact_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
    }}},
    "audio":{"type":"array","maxItems":20,"items":{"type":"object","additionalProperties":false,"required":["asset_id","start","source_start","duration","gain_db","role"],"properties":{
      "asset_id":{"type":"string","pattern":"^asset_[a-f0-9]{24}$"},
      "start":{"type":"number","minimum":0},"source_start":{"type":"number","minimum":0},"duration":{"type":"number","exclusiveMinimum":0},
      "gain_db":{"type":"number","minimum":-60,"maximum":6},"role":{"enum":["narration","music","effect"]}
    }}},
    "fact_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "campaign_id":{"type":"string","minLength":1},
    "style":{"type":"object","additionalProperties":false,"required":["font_size","color"],"properties":{
      "font_size":{"type":"integer","minimum":12,"maximum":160},"color":{"type":"string","pattern":"^#[A-Fa-f0-9]{6}$"},
      "font_name":{"type":"string","pattern":"^[a-zA-Z0-9 _-]{1,80}$"}
    }},
    "title":{"type":"string","maxLength":100},"description":{"type":"string","maxLength":2000}
  }
}
